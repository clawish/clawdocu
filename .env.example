# ClawDocu Configuration
# Copy this file to .env and fill in your values

# Admin password for login
ADMIN_PASSWORD=your-secure-password

# GitHub Personal Access Token (required for repo access)
# Create one at: https://github.com/settings/tokens
# Needs 'repo' scope for private repos, 'public_repo' for public only
GITHUB_TOKEN=ghp_your-token-here

# Gitee Personal Access Token (optional — enables Gitee as a repo source)
# Create one at: https://gitee.com/profile/personal_access_tokens
# Needs 'projects' scope for repo access
GITEE_TOKEN=

# ClawDocu URL (for share links)
# Set this to your ClawDocu instance URL
# Used in metadata.json and claw-guide.md for sharing
# Example: https://clawdocu.example.com or https://clawdocu.yourdomain.com
CLAWDOCU_URL=https://clawdocu.example.com
